    "create_pr": "bun scripts/create-pr.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "htmlhint": "^1.7.1",
    "npm-run-all": "^4.1.5",
    "purgecss": "^7.0.2",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1"
  }
